<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageId>WednumiComponents</PackageId>
	<Version>1.0.0</Version>
	<Authors>Mykhailo Sereda</Authors>
	<Company>Wednumi</Company>
	<Description>My reusable Blazor components</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Items\SoftMenuItem - Copy.razor.css" />
    <None Remove="Lists\MenuItem.razor.css" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="6.0.10" />
    <PackageReference Include="Microsoft.JSInterop" Version="6.0.13" />
  </ItemGroup>

</Project>
